{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["pce_addr", "api_key", "data_directory", "consumers"],
  "properties": {
    "pce_addr": {
      "description": "PCE host name, optionally with :port, that receives the uploads",
      "type": "string"
    },
    "proxy_config": {
      "description": "Proxy settings for the connection to the PCE",
      "type": "object",
      "properties": {
        "https_proxy": {
          "description": "Proxy for HTTPS",
          "type": "string"
        },
        "http_proxy": {
          "description": "Proxy for HTTP",
          "type": "string"
        },
        "no_proxy": {
          "description": "Hosts, IPs or CIDRs to reach without the proxy, comma-separated",
          "type": "string"
        }
      }
    },
    "api_key": {
      "description": "Where the PCE API credentials come from: a file holding a key JSON or 'user token', or, when prefixed with $, a command whose output is used",
      "type": "string"
    },
    "org_id": {
      "description": "PCE organization id",
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "verify_pce_cert": {
      "description": "Check the PCE's TLS certificate",
      "type": "boolean",
      "default": true
    },
    "aggregation_minutes": {
      "description": "Length of the aggregation window in minutes (5 to 60)",
      "type": "integer",
      "minimum": 5,
      "maximum": 60,
      "default": 10
    },
    "data_directory": {
      "description": "Directory for queued uploads and state files",
      "type": "string"
    },
    "data_directory_size_mb": {
      "description": "Size limit of the queued uploads in MB; the oldest are removed first",
      "type": "integer",
      "minimum": 100,
      "default": 500
    },
    "file_retention_hours": {
      "description": "Hours a queued upload is kept before it is removed",
      "type": "integer",
      "minimum": 4,
      "default": 24
    },
    "metrics_print_seconds": {
      "description": "Interval of the metrics log lines in seconds",
      "type": "integer",
      "minimum": 15,
      "default": 60
    },
    "max_flows_per_post": {
      "description": "Maximum number of flow records in one upload",
      "type": "integer",
      "minimum": 2500,
      "maximum": 20000,
      "default": 10000
    },
    "pce_kafka": {
      "description": "PCE Kafka (integrations) mode; not supported by FlowPilot",
      "type": "object",
      "required": ["installation_id"],
      "properties": {
        "installation_id": {
          "description": "Installation identifier",
          "type": "string"
        },
        "env_override": {
          "description": "Environment name override",
          "type": "string",
          "enum": ["dev", "stage"]
        },
        "kafka_info": {
          "description": "File, or $command, with the Kafka connection JSON",
          "type": "string"
        }
      }
    },
    "consumers": {
      "description": "The flow inputs: each pairs a parser with one or more connectors",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "parser", "connectors"],
        "properties": {
          "name": {
            "description": "Name of the input, used in logs and metrics",
            "type": "string"
          },
          "parser": {
            "description": "How received data is decoded",
            "type": "object",
            "properties": {
              "type": {
                "description": "Parser name",
                "type": "string",
                "enum": ["text", "ipfix", "netflow", "sflow", "aws"]
              },
              "properties": {
                "description": "Text parser settings; each field is an attribute name or a 1-based field number",
                "type": "object",
                "required": ["src_ip", "dst_ip", "dst_port", "protocol"],
                "additionalProperties": false,
                "properties": {
                  "src_ip": {
                    "description": "Source address",
                    "type": ["string", "integer"]
                  },
                  "dst_ip": {
                    "description": "Destination address",
                    "type": ["string", "integer"]
                  },
                  "dst_port": {
                    "description": "Destination port",
                    "type": ["string", "integer"]
                  },
                  "protocol": {
                    "description": "IP protocol",
                    "type": ["string", "integer"]
                  },
                  "icmp_type": {
                    "description": "ICMP type",
                    "type": ["string", "integer"]
                  },
                  "icmp_code": {
                    "description": "ICMP code",
                    "type": ["string", "integer"]
                  },
                  "octets": {
                    "description": "Byte count",
                    "type": ["string", "integer"]
                  },
                  "timestamp": {
                    "description": "Time of the record (default: field 1)",
                    "type": ["string", "integer"]
                  },
                  "timestamp_format": {
                    "description": "Layout of the time, see docs/collectors.md",
                    "type": "string"
                  },
                  "only_recs": {
                    "description": "Text a line must contain to be used, see docs/collectors.md",
                    "type": "string"
                  },
                  "field_separator": {
                    "description": "Separator between fields (default: space)",
                    "type": "string"
                  },
                  "attribute_separator": {
                    "description": "Separator between an attribute name and its value (default: =)",
                    "type": "string"
                  }
                }
              }
            }
          },
          "connectors": {
            "description": "Where the data is received",
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "type": {
                  "description": "Connector name",
                  "type": "string",
                  "enum": ["udp", "tcp", "kafka", "aws"]
                },
                "properties": {
                  "description": "Connector settings",
                  "type": "object",
                  "oneOf": [
                    {
                      "description": "udp and tcp",
                      "additionalProperties": false,
                      "properties": {
                        "ports": {
                          "description": "Ports to listen on, comma-separated, as a string",
                          "type": "string"
                        },
                        "remote_addrs": {
                          "description": "Only accept data from these addresses, comma-separated",
                          "type": "string"
                        }
                      }
                    },
                    {
                      "description": "kafka (not supported by FlowPilot)",
                      "required": ["version", "brokers", "group", "topics"],
                      "additionalProperties": false,
                      "properties": {
                        "version": {
                          "description": "Broker version",
                          "type": "string"
                        },
                        "brokers": {
                          "description": "Brokers, comma-separated",
                          "type": "string"
                        },
                        "broker_certs": {
                          "description": "File, or $command, with the client certificates",
                          "type": "string"
                        },
                        "broker_keys": {
                          "description": "File, or $command, with the client keys",
                          "type": "string"
                        },
                        "group": {
                          "description": "Consumer group",
                          "type": "string"
                        },
                        "topics": {
                          "description": "Topics, comma-separated",
                          "type": "string"
                        },
                        "client_id": {
                          "description": "Client id",
                          "type": "string"
                        },
                        "instances": {
                          "description": "Number of consumers",
                          "type": "integer"
                        }
                      }
                    },
                    {
                      "description": "aws (not supported by FlowPilot)",
                      "required": ["region", "credentials", "log_groupname"],
                      "additionalProperties": false,
                      "properties": {
                        "region": {
                          "description": "AWS region",
                          "type": "string"
                        },
                        "credentials": {
                          "description": "File, or $command, with the AWS credentials",
                          "type": "string"
                        },
                        "log_groupname": {
                          "description": "CloudWatch log group",
                          "type": "string"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
