{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "enabled": { "type": "boolean" },
    "dry_run": { "type": "boolean" },
    "networks": { "type": "array", "items": { "type": "string" } },
    "exclude_networks": { "type": "array", "items": { "type": "string" } },
    "allow_broad_networks": { "type": "boolean" },
    "min_flows": { "type": "integer" },
    "flow_window_hours": { "type": "integer" },
